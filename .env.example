# EduMind Frontend Environment Configuration

# Backend API base URL (Render service URL without trailing slash)
VITE_API_BASE_URL=https://api.example.com

# Staging-only Demo Credentials Visibility Flag
# Set to 'true' ONLY in staging environments for evaluator testing.
# Default is 'false'. Never set to 'true' in production.
# Note: This flag controls UI button visibility only; backend/database
# isolation must provide the actual security boundary.
VITE_SHOW_DEMO_CREDENTIALS=false
